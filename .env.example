# ===== ElectionIQ Environment Variables =====

# Server Port
PORT=8080

# Google Gemini API Key (required for AI chat)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Custom Search API (required for election news)
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Google Analytics 4 Measurement ID
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps JavaScript API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth Client ID (for Sign in with Google)
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abc123

# Google Sheets API (for quiz score logging)
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
